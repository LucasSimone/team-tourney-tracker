# ============================================================================
# TEAM TOURNEY TRACKER - Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret Key - Used to sign authentication tokens
# IMPORTANT: Set this to a strong random value in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production

# CORS Origin - Restrict API access to specific frontend domain
# Set to your frontend URL in production
# Examples: https://yourdomain.com, http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API URL for Frontend (used during build)
# In development: http://localhost:8080
# In production: https://your-api-domain.com
VITE_API_URL=http://localhost:8080

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================

# Backend server port (default: 8080)
# BACKEND_PORT=8080

# Frontend server port (default: 5173)
# FRONTEND_PORT=5173

# Database file location (default: /db/sports.db)
# DB_PATH=/db/sports.db

# ============================================================================
# NOTES FOR PRODUCTION
# ============================================================================
#
# 1. JWT_SECRET: Use a cryptographically secure random string
#    Never use default value
#
# 2. CORS_ORIGIN: Restrict to your exact domain
#    Avoid using * (wildcard) in production
#
# 3. Email Setup: Requires Gmail app password, not regular password
#    Make sure 2-Step Verification is enabled
#
# 4. API URL: Match your production backend endpoint
#    Use HTTPS in production
#
# 5. Default Credentials: Change immediately after setup
#    Default users: lucas/password (admin), baddyboi/password (user)
#
# ============================================================================
